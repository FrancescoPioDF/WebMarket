<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="webmarketPU" transaction-type="RESOURCE_LOCAL">

        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <non-jta-data-source>java:/comp/env/jdbc/webmarket</non-jta-data-source>

        <class>it.univaq.pio.webmarket.model.User</class>
        <class>it.univaq.pio.webmarket.model.Category</class>
        <class>it.univaq.pio.webmarket.model.Characteristic</class>
        <class>it.univaq.pio.webmarket.model.PurchaseRequest</class>
        <class>it.univaq.pio.webmarket.model.RequestCharacteristic</class>
        <class>it.univaq.pio.webmarket.model.PurchaseProposal</class>

        <properties>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="jakarta.persistence.schema-generation.database.action" value="update"/>

            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>